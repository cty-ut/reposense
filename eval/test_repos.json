{
  "description": "RepoSense benchmark test set — 10 repos across languages and scales, with multi-turn Q&A scripts for coherence testing",
  "repos": [
    {
      "name": "pallets/click",
      "language": "Python",
      "scale": "medium",
      "expected": {
        "project_type": "library",
        "core_directories": ["src/click"],
        "entry_points": ["src/click/__init__.py", "src/click/core.py"],
        "key_modules": ["core.py", "decorators.py", "types.py", "parser.py", "utils.py"]
      },
      "questions": [
        {
          "q": "What is the main entry point of this project?",
          "must_mention": ["src/click/core.py", "BaseCommand", "Group"]
        },
        {
          "q": "How does Click handle command-line argument parsing?",
          "must_mention": ["parser.py", "OptionParser"]
        },
        {
          "q": "What decorators does Click provide and where are they defined?",
          "must_mention": ["decorators.py", "@command", "@group", "@option", "@argument"]
        },
        {
          "q": "How does Click handle different parameter types?",
          "must_mention": ["types.py", "ParamType", "STRING", "INT"]
        },
        {
          "q": "What is the Context class and what does it do?",
          "must_mention": ["core.py", "Context"]
        }
      ]
    },
